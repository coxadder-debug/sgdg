local SwitchTab
SwitchTab = function(key)
    if ActiveTab==key then return end
    if ActiveTab then
        TabFrames[ActiveTab].main.Visible=false
        TW(TabBtns[ActiveTab],0.1,{BackgroundColor3=C.tabi, TextColor3=C.dim}):Play()
        local ul=TabBtns[ActiveTab]:FindFirstChild("_UL"); if ul then ul:Destroy() end
    end
    ActiveTab=key; TabFrames[key].main.Visible=true
    TW(TabBtns[key],0.1,{BackgroundColor3=C.tabact, TextColor3=C.text}):Play()
    if not TabBtns[key]:FindFirstChild("_UL") then
        local ul=Instance.new("Frame",TabBtns[key]); ul.Name="_UL"
        ul.Size=UDim2.new(1,0,0,2); ul.Position=UDim2.new(0,0,1,-2)
        ul.BackgroundColor3=C.hot; ul.BorderSizePixel=0; ul.ZIndex=16
    end
end

for _,td in ipairs(TabDefs) do
