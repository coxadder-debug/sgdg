local function AntiAnkleStep()
    if _ankleCD then return end
    if not LP.Character then return end
    local root=LP.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
    local ball=FindBall(); if not ball then return end
    if (root.Position-ball.Position).Magnitude>9 then return end
    local spd=Vector3.new(ball.AssemblyLinearVelocity.X,0,ball.AssemblyLinearVelocity.Z).Magnitude
    if spd<18 then return end
    local away=(root.Position-ball.Position); away=Vector3.new(away.X,0,away.Z).Unit
    root.CFrame=CFrame.new(root.Position+away*6,root.Position+away*6+root.CFrame.LookVector)
    local hum=LP.Character:FindFirstChild("Humanoid")
    if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    Stats.AnklesSaved=Stats.AnklesSaved+1; _ankleCD=true; task.delay(0.6,function() _ankleCD=false end)
end

-------------------------------------------------
-- AUTO BLOCK
-------------------------------------------------
local function AutoBlockTick()
    if _blockCD then return end
    if not LP.Character then return end
    local ball=FindBall(); if not ball then return end
    local vel=ball.AssemblyLinearVelocity
    if vel.Y<12 or Vector3.new(vel.X,0,vel.Z).Magnitude<4 then return end
    if HasBall() then return end
    local predicted=PredictBallPos(ball,0.35)
    local root=LP.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
    if (root.Position-predicted).Magnitude>20 then return end
    root.CFrame=CFrame.new(Vector3.new(predicted.X,root.Position.Y,predicted.Z),
        Vector3.new(predicted.X,root.Position.Y,predicted.Z)+root.CFrame.LookVector)
    local hum=LP.Character:FindFirstChild("Humanoid")
    if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    Stats.Blocks=Stats.Blocks+1; _blockCD=true; task.delay(0.9,function() _blockCD=false end)
end

