    btn.MouseEnter:Connect(function() TW(btn,0.08,{BackgroundColor3=C.acc}):Play(); TW(bStr,0.08,{Color=C.hot}):Play() end)
    btn.MouseLeave:Connect(function() TW(btn,0.1,{BackgroundColor3=C.card}):Play(); TW(bStr,0.1,{Color=C.border}):Play() end)
