-- Toggle (Linoria checkbox square)
local function WT(p,label,cfg,cb)
    local row=Instance.new("Frame",p); row.Size=UDim2.new(1,0,0,22)
    row.BackgroundTransparency=1; row.BorderSizePixel=0; row.LayoutOrder=NO(p)
    local box=Instance.new("Frame",row); box.Size=UDim2.new(0,10,0,10); box.Position=UDim2.new(0,0,0.5,-5)
    box.BackgroundColor3=cfg.on and C.on or C.off; box.BorderSizePixel=0
    local bStr=Instance.new("UIStroke",box); bStr.Color=cfg.on and C.bright or C.border; bStr.Thickness=1
    local lbl=Instance.new("TextLabel",row); lbl.Size=UDim2.new(1,-16,1,0); lbl.Position=UDim2.new(0,15,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=cfg.on and C.text or C.dim
    lbl.Font=Enum.Font.Code; lbl.TextSize=11; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.ZIndex=12
    local ov=Instance.new("TextButton",row); ov.Size=UDim2.new(1,0,1,0)
    ov.BackgroundTransparency=1; ov.Text=""; ov.BorderSizePixel=0; ov.ZIndex=15
    ov.MouseEnter:Connect(function()
        if not cfg.on then TW(lbl,0.1,{TextColor3=Color3.fromRGB(150,70,85)}):Play() end
    end)
    ov.MouseLeave:Connect(function()
        if not cfg.on then TW(lbl,0.1,{TextColor3=C.dim}):Play() end
    end)
    local function Sync()
        local on=cfg.on
        TW(box,0.12,{BackgroundColor3=on and C.on or C.off}):Play()
        TW(bStr,0.12,{Color=on and C.bright or C.border}):Play()
        TW(lbl,0.12,{TextColor3=on and C.text or C.dim}):Play()
    end
    ov.MouseButton1Click:Connect(function() cfg.on=not cfg.on; Sync(); if cb then cb(cfg.on) end end)
    return Sync
end

-- Slider (Linoria style: val/max on filled bar)
local function WSL(p,label,initVal,lo,hi,cb)
    local row=Instance.new("Frame",p); row.Size=UDim2.new(1,0,0,42)
    row.BackgroundTransparency=1; row.BorderSizePixel=0; row.LayoutOrder=NO(p)
    local lbl=Instance.new("TextLabel",row); lbl.Size=UDim2.new(1,0,0,18); lbl.Position=UDim2.new(0,0,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=C.text
    lbl.Font=Enum.Font.Code; lbl.TextSize=11; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.ZIndex=12
    local track=Instance.new("Frame",row); track.Size=UDim2.new(1,0,0,18); track.Position=UDim2.new(0,0,0,20)
    track.BackgroundColor3=C.card; track.BorderSizePixel=0
    Instance.new("UICorner",track).CornerRadius=UDim.new(0,2)
    local tStr=Instance.new("UIStroke",track); tStr.Color=C.border; tStr.Thickness=1
    local r0=(initVal-lo)/(hi-lo)
    local fill=Instance.new("Frame",track); fill.BackgroundColor3=C.slid; fill.BorderSizePixel=0
    fill.Size=UDim2.new(r0,0,1,0); Instance.new("UICorner",fill).CornerRadius=UDim.new(0,2)
    local vlbl=Instance.new("TextLabel",track); vlbl.Size=UDim2.new(1,0,1,0)
    vlbl.BackgroundTransparency=1; vlbl.Text=tostring(initVal).."/"..tostring(hi)
    vlbl.TextColor3=C.text; vlbl.Font=Enum.Font.Code; vlbl.TextSize=10; vlbl.ZIndex=13
    local tBtn=Instance.new("TextButton",track); tBtn.Size=UDim2.new(1,0,1,0)
    tBtn.BackgroundTransparency=1; tBtn.Text=""; tBtn.ZIndex=14; tBtn.BorderSizePixel=0
    local drag=false
    tBtn.MouseButton1Down:Connect(function() drag=true end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end)
    RunSvc.Heartbeat:Connect(function()
        if not drag then return end
        local mx=UIS:GetMouseLocation().X
        local r=math.clamp((mx-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local v=math.floor(lo+r*(hi-lo))
        fill.Size=UDim2.new(r,0,1,0); vlbl.Text=tostring(v).."/"..tostring(hi)
        if cb then cb(v) end
    end)
end

