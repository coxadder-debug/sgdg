local function HasBall()
    local ball=FindBall(); if not ball then return false end
    if not LP.Character then return false end
    for _,v in ipairs(ball:GetChildren()) do
        if v:IsA("Weld") or v:IsA("WeldConstraint") or v:IsA("Motor6D") then
            local p1=v.Part1
            if p1 and Players:GetPlayerFromCharacter(p1.Parent)==LP then return true end
        end
    end
    local root=LP.Character:FindFirstChild("HumanoidRootPart"); if not root then return false end
    return (root.Position-ball.Position).Magnitude<6 and ball.AssemblyLinearVelocity.Magnitude<8
end
local function PredictBallPos(ball,t)
    return ball.Position+ball.AssemblyLinearVelocity*t+Vector3.new(0,-196.2,0)*0.5*t*t
end

